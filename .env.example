# =========================================================
# TripMate AI - Environment Template (.env.example)
# Copy this file to .env and fill in your credentials
# =========================================================

# Groq Model & API Key (https://console.groq.com/keys)
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_API_KEY=your_groq_api_key_here

# OpenWeatherMap API Key (https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# AviationStack API Key (https://aviationstack.com/)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# Default departure airport IATA code (e.g., DAC, JFK, LHR)
DEFAULT_ORIGIN_IATA="DAC"

# Tavily API Key (https://app.tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# Neon PostgreSQL Connection URL (https://console.neon.tech)
# Neon provides permanent free serverless PostgreSQL (unlike Render's 30-day limit)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# LangSmith Tracing & Observability (optional, set to true if providing a key)
LANGSMITH_TRACING="false"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="TripMate-AI"

# Custom Weather MCP Server Script Path
WEATHER_SERVER_PATH="c:\\Users\\pauls\\OneDrive\\Desktop\\Multi-Agent-System\\custom_weather_mcp_server.py"
